# Override global gitignore for top-level CLAUDE docs (tracked in this repo)
!/CLAUDE.md
!/CLAUDE_*.md

# Project-shared Claude config: commands/, agents/, guides/ and the reviewer
# dispatch hook are tracked. Everything else under .claude/ (CLAUDE.md,
# settings.json, the vexp hooks, learnings/, metrics.json, locks, installer
# baselines and agent-generated reports) is personal or machine-local.
!.claude/
!.claude/commands/
!.claude/commands/**
!.claude/agents/
!.claude/agents/**
!.claude/guides/
!.claude/guides/**
.claude/agents/reports/
.claude/CLAUDE.md
.claude/settings.json
.claude/hooks/*
!.claude/hooks/reviewer-dispatch.cjs
.claude/.baseline/
*.backup-????-??-??T??-??-??-???Z
*.vexp-bak
.claude/learnings/
.claude/metrics.json
.claude/scheduled_tasks.lock

# Secrets
.env

# Generated config
config.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
.coverage
.pytest_cache/

# uv
.python-version

# Node
node_modules/

# Data (keep structure, ignore contents)
data/cache/
data/imports/*.csv
data/imports/*.json
data/imports/*.zip

# Amazon order data
amazon-orders-*.csv
*.zip

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# History backups
.history/

# Compiled Stan models (regenerated by cmdstanpy from the .stan source).
# These are platform-specific ELF/Mach-O binaries — never commit them.
# Pattern: compiled binaries sit next to a same-named .stan file with no
# extension, plus a generated .hpp. We ignore the .hpp everywhere and the
# known compiled-binary basenames in their source dirs.
*.hpp
scripts/inflation_model_*
!scripts/inflation_model_*.stan
!scripts/inflation_model_*.py
models/bvarima
research/**/inflation_model_*
!research/**/inflation_model_*.stan
!research/**/inflation_model_*.py
research/**/bvarima
!research/**/bvarima.stan

# Scratch diagnostics (throwaway, per CLAUDE.md convention)
scripts/scratch_*.py
research/**/scratch_*.py
