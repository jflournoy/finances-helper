# Override global gitignore for top-level CLAUDE docs (tracked in this repo)
!/CLAUDE.md
!/CLAUDE_*.md

# Project-shared Claude config: only commands/ and agents/ are tracked.
# Everything else under .claude/ (CLAUDE.md, settings.json, hooks/,
# learnings/, metrics.json, locks, agent-generated reports) stays personal.
!.claude/
!.claude/commands/
!.claude/commands/**
!.claude/agents/
!.claude/agents/**
.claude/agents/reports/
.claude/CLAUDE.md
.claude/settings.json
.claude/hooks/
.claude/learnings/
.claude/metrics.json
.claude/scheduled_tasks.lock

# Secrets
.env

# Generated config
config.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
.coverage
.pytest_cache/

# uv
.python-version

# Node
node_modules/

# Data (keep structure, ignore contents)
data/cache/
data/imports/*.csv
data/imports/*.json
data/imports/*.zip

# Amazon order data
amazon-orders-*.csv
*.zip

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# History backups
.history/

# Compiled Stan models (regenerated by cmdstanpy)
scripts/inflation_model
scripts/inflation_model.hpp
scripts/inflation_model_time_varying
scripts/inflation_model_time_varying.hpp
